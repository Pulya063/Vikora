{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vikora-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"ratelimits": [
		{
			"name": "PUBLIC_RATE_LIMITER",
			"namespace_id": "42101",
			"simple": {
				"limit": 120,
				"period": 60
			}
		},
		{
			"name": "LEAD_RATE_LIMITER",
			"namespace_id": "42102",
			"simple": {
				"limit": 20,
				"period": 60
			}
		}
	],
	"vars": {
		"APP_ENV": "local",
		"ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:8788,http://127.0.0.1:8788,https://vikora-web-local.vikora-info.workers.dev",
		"TURNSTILE_BYPASS": "true",
		"NOTION_DATA_SOURCE_ID": "eb068d8c-f745-4f92-a76b-4f2b9d4dded1",
		"PUBLIC_SITE_URL": "https://vikora-web-local.vikora-info.workers.dev",
		"TELEGRAM_MANAGER_CHAT_ID": "",
		"TELEGRAM_BOT_USERNAME": "Vikora_servis_bot"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vikora_db",
			"database_id": "6ab96508-1456-474e-91b6-8557eaeaac07",
			"migrations_dir": "migrations"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "EVENT_QUEUE",
				"queue": "vikora-events-local"
			}
		],
		"consumers": [
			{
				"queue": "vikora-events-local",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"dead_letter_queue": "vikora-events-dlq-local"
			}
		]
	},
	"triggers": {
		"crons": [
			"0 * * * *"
		]
	},
	// Workers Builds previews (non-production branches). Previews do NOT inherit top-level
	// settings; no queue consumers or crons here. Shares the local/test D1 database.
	"previews": {
		"observability": {
			"enabled": true
		},
		"vars": {
			"APP_ENV": "local",
			"ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000,https://vikora-web-local.vikora-info.workers.dev",
			"TURNSTILE_BYPASS": "true",
			"NOTION_DATA_SOURCE_ID": "",
			"PUBLIC_SITE_URL": "https://vikora-web-local.vikora-info.workers.dev",
			"TELEGRAM_MANAGER_CHAT_ID": "",
			"TELEGRAM_BOT_USERNAME": "Vikora_servis_bot"
		},
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "vikora_db",
				"database_id": "6ab96508-1456-474e-91b6-8557eaeaac07",
				"migrations_dir": "migrations"
			}
		],
		"queues": {
			"producers": [
				{
					"binding": "EVENT_QUEUE",
					"queue": "vikora-events-local"
				}
			]
		}
	},
	"env": {
		"staging": {
			"name": "vikora-api-staging",
			"ratelimits": [
				{
					"name": "PUBLIC_RATE_LIMITER",
					"namespace_id": "42111",
					"simple": {
						"limit": 120,
						"period": 60
					}
				},
				{
					"name": "LEAD_RATE_LIMITER",
					"namespace_id": "42112",
					"simple": {
						"limit": 20,
						"period": 60
					}
				}
			],
			"vars": {
				"APP_ENV": "staging",
				"ALLOWED_ORIGINS": "https://vikora-web-staging.vikora-info.workers.dev",
				"TURNSTILE_BYPASS": "false",
				"NOTION_DATA_SOURCE_ID": "",
				"TELEGRAM_MANAGER_CHAT_ID": "",
				"TELEGRAM_BOT_USERNAME": "Vikora_servis_bot"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "vikora-staging",
					"database_id": "11111111-1111-1111-1111-111111111111",
					"migrations_dir": "migrations"
				}
			],
			"queues": {
				"producers": [
					{
						"binding": "EVENT_QUEUE",
						"queue": "vikora-events-staging"
					}
				],
				"consumers": [
					{
						"queue": "vikora-events-staging",
						"max_batch_size": 10,
						"max_retries": 5,
						"dead_letter_queue": "vikora-events-dlq-staging"
					}
				]
			},
			"triggers": {
				"crons": [
					"0 * * * *"
				]
			}
		},
		"production": {
			"name": "vikora-api-prod",
			"ratelimits": [
				{
					"name": "PUBLIC_RATE_LIMITER",
					"namespace_id": "42121",
					"simple": {
						"limit": 120,
						"period": 60
					}
				},
				{
					"name": "LEAD_RATE_LIMITER",
					"namespace_id": "42122",
					"simple": {
						"limit": 20,
						"period": 60
					}
				}
			],
			"vars": {
				"APP_ENV": "production",
				"ALLOWED_ORIGINS": "https://vikora-web.vikora-info.workers.dev",
				"TURNSTILE_BYPASS": "false",
				"NOTION_DATA_SOURCE_ID": "",
				"TELEGRAM_MANAGER_CHAT_ID": "",
				"TELEGRAM_BOT_USERNAME": "Vikora_servis_bot"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "vikora-production",
					"database_id": "22222222-2222-2222-2222-222222222222",
					"migrations_dir": "migrations"
				}
			],
			"queues": {
				"producers": [
					{
						"binding": "EVENT_QUEUE",
						"queue": "vikora-events"
					}
				],
				"consumers": [
					{
						"queue": "vikora-events",
						"max_batch_size": 10,
						"max_retries": 5,
						"dead_letter_queue": "vikora-events-dlq"
					}
				]
			},
			"triggers": {
				"crons": [
					"0 * * * *"
				]
			}
		}
	}
}
