DATABASE_URL=postgresql+asyncpg://vikora:vikora_local@127.0.0.1:55432/vikora
APP_ENV=local
# Cloud database: verify-full; optional CA bundle path for AWS RDS.
DATABASE_SSL_MODE=disable
DATABASE_SSL_CA_FILE=
# Only verified reverse-proxy IP addresses/CIDRs. Empty disables forwarded headers.
TRUSTED_PROXY_IPS=
ALLOWED_HOSTS=["localhost","127.0.0.1","app"]
MAX_IN_FLIGHT=32
REQUESTS_PER_MINUTE=120
MAX_REQUEST_BYTES=32768
REQUEST_BODY_TIMEOUT=10
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=
TELEGRAM_ADMIN_IDS=[]
TELEGRAM_WEBHOOK_SECRET=
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
PUBLIC_SITE_URL=http://localhost:3000
