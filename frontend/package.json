{
  "name": "vikora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:contract": "node --test tests/quote-contract.cjs tests/public-api-routes.cjs",
    "test:forms": "playwright test --config=playwright.forms.config.ts",
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "dev:lan": "node scripts/dev-lan.cjs",
    "build": "next build --webpack",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "browser": "playwright-cli -s=vikora",
    "browser:open": "playwright-cli -s=vikora open",
    "browser:snapshot": "playwright-cli -s=vikora snapshot",
    "browser:screenshot": "playwright-cli -s=vikora screenshot",
    "browser:close": "playwright-cli -s=vikora close"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@playwright/cli": "^0.1.22",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
