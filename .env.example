# Local Docker Compose settings. Copy this file to .env.
# Local development credentials; use your own password for deployment.
# If the password contains URL-reserved characters, URL-encode it in DATABASE_URL.
POSTGRES_USER=vikora
POSTGRES_PASSWORD=vikora_local
POSTGRES_DB=vikora
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Backend settings. Lists must use JSON syntax.
APP_ENV=local
DATABASE_SSL_MODE=disable
DATABASE_SSL_CA_FILE=
TRUSTED_PROXY_IPS=
ALLOWED_HOSTS=["localhost","127.0.0.1","app"]
MAX_IN_FLIGHT=32
REQUESTS_PER_MINUTE=120
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
PUBLIC_SITE_URL=http://localhost:3000
# Frontend settings are embedded during the Docker build.
# API_URL uses the Compose service name, not localhost.
API_URL=http://app:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ALLOW_INDEXING=false
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_TURNSTILE_BYPASS=false
NEXT_PUBLIC_BACKEND_MODE=legacy

# Optional Telegram integration: fill in your real credentials to enable it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=
TELEGRAM_ADMIN_IDS=[]
TELEGRAM_WEBHOOK_SECRET=

# Optional Notion integration: fill in your real credentials to enable it.
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
